# Application environment: development | production
APP_ENV=development

# Flask / JWT secrets (change these in real environments)
SECRET_KEY=change-me-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key

# Legacy alias still supported by config (optional if SECRET_KEY is set)
MY_SECRET_KEY=change-me-secret-key

# Internal API key for ingestion endpoints (X-API-Key header)
API_KEY=change-me-internal-api-key

# Database
# A full URI wins: DEV_DATABASE_URI (development) / PROD_DATABASE_URI (production).
# Without it the app uses MySQL from the parts below
# (database: DEV_MYSQL_DATABASE in development, MYSQL_DATABASE in production).
# MYSQL_PASSWORD has no default in code; it must be set here. Any characters are allowed.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ies_monitoring
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_DATABASE=ies_monitoring
DEV_MYSQL_DATABASE=ies_monitoring_dev

# Development stays on SQLite while this is set; remove it to use DEV_MYSQL_DATABASE.
DEV_DATABASE_URI=sqlite:///dev.db
# PROD_DATABASE_URI=mysql+pymysql://user:password@localhost:3306/ies_monitoring?charset=utf8mb4

#Logging configuration
LOG_DIR=logs
LOG_LEVEL=Debug

# Email configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail@iliauni.edu.ge
MAIL_PASSWORD=your_mail_password

# WordPress earthquake publish (admin-ajax)
WP_AJAX_URL=https://ies-staging.iliauni.edu.ge/wp-admin/admin-ajax.php
WP_PUBLISH_CODE=change-me-wp-publish-code
# Set false for staging hosts with incomplete TLS chains
WP_SSL_VERIFY=false

# Google Maps JavaScript API (browser key, restrict by HTTP referrer)
GOOGLE_MAPS_API_KEY=
